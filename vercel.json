{
  "installCommand": "echo 'Dependencies resolved inside build.sh (Flutter SDK is not preinstalled on Vercel)'",
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
